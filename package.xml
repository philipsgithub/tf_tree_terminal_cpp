<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tf_tree_terminal_cpp</name>
  <version>3.0.0</version>
  <description>A lightweight ROS 2 utility to visualize the Coordinate Transform (TF) tree directly in the terminal with a folder-style structure. C++ port of tf_tree_terminal.</description>
  <maintainer email="philipkellr@gmail.com">Philip Keller</maintainer>
  <license>MIT</license>
  <author email="tanneguydv@gmail.com">Tanneguy de Villemagne</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_msgs</depend>

  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
